{
  "worktreeRoot": "../{repo}-work",
  "models": {
    "mimo-flash": {
      "id": "opencode-go/mimo-v2.6-flash",
      "family": "mimo",
      "watch": "New (the owner, 2026-10-09): takes the place of a model blacklisted on every route (L67). The owner tested it on implement, fix and review tasks, all passed; not yet run here. It offers no variants, so no variant field. A family of its own (mimo) for the reviewer-family rule."
    },
    "luna": {
      "id": "openai/gpt-5.6-luna",
      "variant": "high",
      "family": "openai"
    },
    "luna-6": {
      "id": "openai/gpt-6-luna",
      "variant": "high",
      "family": "openai"
    },
    "sol": {
      "id": "openai/gpt-6-sol",
      "variant": "low",
      "family": "openai"
    },
    "zai-glm-5.3-flash": {
      "id": "zai-coding-plan/glm-5.3-flash",
      "variant": "high",
      "family": "glm"
    },
    "gpt-6.1-sol": {
      "id": "openai/gpt-6.1-sol",
      "variant": "low",
      "family": "openai"
    },
    "zai-glm-5.3": {
      "id": "zai-coding-plan/glm-5.3",
      "variant": "low",
      "family": "glm"
    },
    "mimo-pro": {
      "id": "opencode-go/mimo-v2.6-pro",
      "family": "mimo",
      "watch": "New (the owner, 2026-10-09): takes the place of a model blacklisted on every route (L67). The owner tested it (the heavy model on OpenCode Go) on implement, fix and review tasks, all passed; not yet run here. It offers no variants, so no variant field. A family of its own (mimo) for the reviewer-family rule."
    },
    "mm-m3": {
      "id": "minimax/MiniMax-M3",
      "variant": "thinking",
      "family": "minimax"
    },
    "mm-m2.7": {
      "id": "minimax/MiniMax-M2.7",
      "family": "minimax"
    },
    "ali-qwen-max": {
      "id": "alibaba-token-plan/qwen3.8-max",
      "variant": "low",
      "family": "qwen"
    },
    "ali-qwen-flash": {
      "id": "alibaba-token-plan/qwen3.8-flash",
      "variant": "medium",
      "family": "qwen"
    },
    "ali-glm": {
      "id": "alibaba-token-plan/glm-5.3",
      "variant": "low",
      "family": "glm"
    }
  },
  "implementer": {
    "agent": "implementer",
    "chain": [
      "zai-glm-5.3-flash",
      "mm-m2.7",
      "mimo-flash"
    ],
    "claudeFallback": "sonnet",
    "startupTimeoutSec": 180,
    "idleTimeoutSec": 900,
    "totalTimeoutSec": 10800
  },
  "reviewer": {
    "agent": "reviewer",
    "chain": [
      "luna"
    ],
    "claudeFallback": "sonnet",
    "startupTimeoutSec": 180,
    "idleTimeoutSec": 600,
    "totalTimeoutSec": 3600,
    "hard": [
      "zai-glm-5.3",
      "mimo-pro",
      "luna"
    ],
    "sol": "gpt-6.1-sol"
  },
  "jev": {
    "model": "jev-1.13",
    "baseUrl": "https://openrouter.ai/api",
    "apiKeyEnv": "OPENROUTER_API_KEY",
    "timeoutSec": 30,
    "targetPrecision": 0.95,
    "decisions": {
      "breaks-play": {
        "type": "noul",
        "instructionsFile": "docs/jev/breaks-play.md"
      },
      "task-hard": {
        "type": "noul",
        "instructionsFile": "docs/jev/task-hard.md",
        "autoYesAt": 0.8,
        "trial": {
          "date": "2026-10-03",
          "model": "jev-1.13",
          "instructions": "v2: game rules, formulas or constants from evidence count as hard (owner, 2026-10-03)",
          "labels": "132 task files (imperial_conquest_2 113, game-archaeologist 6, isle-wars-archaeology 8, malpaco 2, toy-archaeology 3), labelled blind by Claude Sonnet agents from docs/jev/task-hard.md (the 46 easy labels of v1 relabelled under v2); 113 hard, 19 easy. Jev is measured against them, not against outcomes",
          "heldOut": {
            "n": 64,
            "yes": {
              "n": 46,
              "precision": 1.0
            },
            "coverage": 0.71875
          },
          "tuning": {
            "n": 68,
            "yes": {
              "n": 51,
              "precision": 0.9608
            },
            "coverage": 0.75
          },
          "noCutoff": "no cutoff for easy reached 0.95; easy stays the main session's"
        }
      }
    }
  },
  "providers": {
    "openrouter": {
      "baseUrl": "https://openrouter.ai/api",
      "apiKeyEnv": "OPENROUTER_API_KEY"
    },
    "elevenlabs": {
      "baseUrl": "https://api.elevenlabs.io",
      "apiKeyEnv": "ELEVENLABS_API_KEY"
    }
  },
  "jail": {
    "enabled": false
  }
}
