{
  "worktreeRoot": "../{repo}-work",
  "models": {
    "deepseek-flash": {
      "id": "opencode-go/deepseek-v4.1-flash",
      "variant": "high",
      "family": "deepseek"
    },
    "luna": {
      "id": "openai/gpt-6-luna",
      "variant": "high",
      "family": "openai"
    },
    "sol": {
      "id": "openai/gpt-6-sol",
      "variant": "high",
      "family": "openai"
    },
    "zai-glm-5.3-flash": {
      "id": "zai-coding-plan/glm-5.3-flash",
      "variant": "high",
      "family": "glm"
    },
    "gpt-6.1-sol": {
      "id": "openai/gpt-6.1-sol",
      "variant": "high",
      "family": "openai"
    }
  },
  "implementer": {
    "agent": "implementer",
    "chain": [
      "zai-glm-5.3-flash"
    ],
    "claudeFallback": "sonnet",
    "startupTimeoutSec": 180,
    "idleTimeoutSec": 900,
    "totalTimeoutSec": 10800
  },
  "reviewer": {
    "agent": "reviewer",
    "chain": [
      "luna"
    ],
    "claudeFallback": "sonnet",
    "startupTimeoutSec": 180,
    "idleTimeoutSec": 600,
    "totalTimeoutSec": 3600
  },
  "jev": {
    "model": "jev-1.13",
    "baseUrl": "https://openrouter.ai/api",
    "apiKeyEnv": "OPENROUTER_API_KEY",
    "timeoutSec": 30,
    "targetPrecision": 0.95,
    "decisions": {
      "breaks-play": {
        "type": "noul",
        "instructionsFile": "docs/jev/breaks-play.md"
      },
      "task-hard": {
        "type": "noul",
        "instructionsFile": "docs/jev/task-hard.md",
        "autoYesAt": 0.9,
        "trial": {
          "date": "2026-10-03",
          "model": "jev-1.13",
          "labels": "132 task files (imperial_conquest_2 113, game-archaeologist 6, isle-wars-archaeology 8, malpaco 2, toy-archaeology 3), labelled blind by three Claude Sonnet agents from docs/jev/task-hard.md; Jev is measured against them, not against outcomes",
          "heldOut": {
            "n": 64,
            "yes": {
              "n": 22,
              "precision": 1.0
            },
            "no": {
              "n": 0,
              "precision": null
            },
            "coverage": 0.34375
          },
          "tuning": {
            "n": 68,
            "yes": {
              "n": 22,
              "precision": 0.9545
            },
            "coverage": 0.3235
          },
          "noCutoff": "no end of 'easy' reached the 0.95 target; easy stays the main session's"
        }
      }
    }
  },
  "providers": {
    "openrouter": {
      "baseUrl": "https://openrouter.ai/api",
      "apiKeyEnv": "OPENROUTER_API_KEY"
    },
    "elevenlabs": {
      "baseUrl": "https://api.elevenlabs.io",
      "apiKeyEnv": "ELEVENLABS_API_KEY"
    }
  }
}
