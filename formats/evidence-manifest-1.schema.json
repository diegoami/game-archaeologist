{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-manifest/1",
  "title": "Evidence manifest",
  "description": "The files of one run's evidence bundle, at evidence/E<nnn>/<run-id>.manifest.json. Each file is a release asset named <sha256[:16]>-<name> in the experiment's release. Downloads are verified against `sha256`. The manifests are the evidence index (docs/phase0/05-artifacts.md §4).",
  "type": "object",
  "properties": {
    "schema": {
      "const": "evidence-manifest/1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^E[0-9]{3,}-r[0-9]{4,}$"
    },
    "experiment": {
      "type": "string",
      "pattern": "^E[0-9]{3,}$"
    },
    "store": {
      "type": "string",
      "pattern": "^(release:E[0-9]{3,}|repo:.+)$"
    },
    "artifact": {
      "type": "object",
      "properties": {
        "set": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*-[0-9a-f]{8}$",
          "description": "artifact-set id"
        },
        "variant": {
          "type": [
            "string",
            "null"
          ],
          "description": "variant id, or null when the unmodified set ran"
        }
      },
      "required": [
        "set",
        "variant"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "asset": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}-.+$"
          },
          "class": {
            "enum": [
              "save",
              "screenshot",
              "recording",
              "memory-dump",
              "trace",
              "log",
              "other"
            ]
          }
        },
        "required": [
          "name",
          "bytes",
          "sha256",
          "asset",
          "class"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "run_id",
    "experiment",
    "store",
    "artifact",
    "files"
  ],
  "additionalProperties": false
}
