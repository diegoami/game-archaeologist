{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact-set/1",
  "title": "Artifact set",
  "description": "The files a runtime needs. `id` ends with the first 8 hex of the sha256 of the canonical manifest: this object without `id` and `acquired`, files sorted by path, serialised as JSON with sorted keys, separators (',', ':'), UTF-8 (formats/README.md). Hashes are committed; bytes never are.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "artifact-set/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*-[0-9a-f]{8}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "as stated by the artifact itself, else 'unknown'"
    },
    "acquired": {
      "type": "object",
      "properties": {
        "how": {
          "type": "string",
          "pattern": "^(purchased download|user-supplied install|archive item .+|generated)$"
        },
        "when": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "note": {
          "type": "string",
          "description": "free text, no personal data"
        }
      },
      "required": [
        "how",
        "when"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "runtime_writes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "globs of files the runtime creates or changes"
    }
  },
  "required": [
    "schema",
    "id",
    "title",
    "version",
    "acquired",
    "files",
    "runtime_writes"
  ],
  "additionalProperties": false
}
